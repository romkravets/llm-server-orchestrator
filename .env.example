# Copy to .env (gitignored) in this directory. Real exported env vars
# always take priority over these — this file is just a convenience so you
# don't have to `export` everything by hand each session.

# --- Approval gate -------------------------------------------------------
# 1 = land safe changes (safe paths, clean reviewer/security) with no human.
# 0 = every run needs a human approval (Telegram if configured, else terminal).
AUTO_APPROVE_SAFE=1

# Comma-separated path prefixes considered "safe" to auto-land. Anything
# touching a path outside this list always needs a human.
SAFE_PATH_PREFIXES=src/content/photos/,public/photos/

# --- Telegram approval gate ----------------------------------------------
# 1. @BotFather -> /newbot -> copy the token below.
# 2. Message your new bot anything once (so it can see your chat), then run:
#      curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | python3 -m json.tool
#    and copy message.chat.id into TELEGRAM_CHAT_ID below.
# Leave both blank to keep the plain terminal y/N prompt as the only gate.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_TIMEOUT_SEC=1800
